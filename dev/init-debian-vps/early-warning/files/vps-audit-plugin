#!/usr/bin/python3
"""Alert only on authorized_keys, sshd, and firewall file changes."""
from __future__ import annotations

import re
import subprocess
import sys

ALERT = "/usr/local/sbin/vps-alert"
KEY_RE = re.compile(r'key="?vps_ew"?')
FIELD_RE = re.compile(r'\b(?P<field>exe|name|nametype|syscall|auid|uid)=(?P<value>"[^"]*"|[^\s]+)')
PATH_RE = re.compile(r'\bname=(?:"(?P<quoted>[^"]+)"|(?P<bare>[^\s]+))')


def audit_path(line: str) -> str:
    match = PATH_RE.search(line)
    if not match:
        return ""
    return (match.group("quoted") or match.group("bare") or "").strip("'")


def classify(line: str) -> tuple[str, str] | None:
    path = audit_path(line)
    if path == "/etc/vps-alert/watch-test":
        return None
    if path.endswith("/.ssh/authorized_keys") or path.endswith("/authorized_keys"):
        return "authorized-keys-change", path
    if path == "/etc/ssh/sshd_config" or path.startswith("/etc/ssh/sshd_config.d/"):
        return "sshd-config-change", path
    if path == "/etc/nftables.conf" or path.startswith("/etc/nftables.d/"):
        return "firewall-change", path
    # Other audit records remain available in auditd, but are intentionally
    # not sent to Discord by this notification path.


def summarize(line: str) -> str:
    parts: list[str] = []
    path = audit_path(line)
    if path:
        parts.append(f"path={path}")
    for match in FIELD_RE.finditer(line):
        field = match.group("field")
        if field == "name":
            continue
        parts.append(f"{field}={match.group('value').strip(chr(34))}")
    return " ".join(parts)[:500] or line[:500]


def main() -> int:
    sys.stdin.reconfigure(errors="replace")
    for line in sys.stdin:
        line = line.strip()
        if not line or not KEY_RE.search(line):
            continue
        classified = classify(line)
        if classified is None:
            continue
        event, path = classified
        try:
            subprocess.Popen(
                [
                    ALERT,
                    "--event",
                    event,
                    "--severity",
                    "critical",
                    "--outcome",
                    "change",
                    "--key",
                    f"{event}:{path}",
                    "--body",
                    summarize(line),
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
