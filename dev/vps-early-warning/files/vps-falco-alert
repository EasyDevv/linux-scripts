#!/usr/bin/python3
"""Read Falco JSON alerts and forward WARNING+ to vps-alert."""

from __future__ import annotations

import json
import subprocess
import sys

ALERT = "/usr/local/sbin/vps-alert"
SKIP = {"debug", "informational", "notice", "info", "none"}


def main() -> int:
    sys.stdin.reconfigure(errors="replace")
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        priority = str(event.get("priority", "")).lower()
        if priority in SKIP:
            continue
        rule = str(event.get("rule", "falco"))[:80]
        output = str(event.get("output", raw))[:400]
        try:
            subprocess.Popen(
                [ALERT, f"falco:{rule}", output],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
