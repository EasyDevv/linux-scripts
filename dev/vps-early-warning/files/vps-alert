#!/usr/bin/python3
"""Send one Discord message. Never print the webhook."""

from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ENV_FILE = Path("/etc/vps-alert/discord.env")
STATE_DIR = Path("/var/lib/vps-alert")
STATE_FILE = STATE_DIR / "throttle.json"
HOST = os.uname().nodename
THROTTLE_SEC = 120
WINDOW_SEC = 600
MAX_PER_WINDOW = 20
MAX_LEN = 1800


def load_webhook() -> str:
    if not ENV_FILE.is_file():
        raise SystemExit("vps-alert: missing env file")
    webhook = ""
    for raw in ENV_FILE.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() != "DISCORD_WEBHOOK":
            continue
        webhook = value.strip().strip("'").strip('"')
    if not webhook.startswith("https://"):
        raise SystemExit("vps-alert: webhook missing or not https")
    return webhook


def load_state() -> dict:
    if not STATE_FILE.is_file():
        return {"sent": [], "last": {}}
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"sent": [], "last": {}}


def save_state(state: dict) -> None:
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state), encoding="utf-8")
    tmp.replace(STATE_FILE)


def allow(key: str) -> bool:
    now = time.time()
    state = load_state()
    sent = [ts for ts in state.get("sent", []) if now - ts < WINDOW_SEC]
    last = {k: ts for k, ts in state.get("last", {}).items() if now - ts < WINDOW_SEC}
    if key in last and now - last[key] < THROTTLE_SEC:
        return False
    if len(sent) >= MAX_PER_WINDOW:
        return False
    sent.append(now)
    last[key] = now
    save_state({"sent": sent, "last": last})
    return True


def main() -> int:
    if len(sys.argv) < 2:
        raise SystemExit("usage: vps-alert <title> [body]")
    title = sys.argv[1].strip() or "alert"
    body = " ".join(sys.argv[2:]).strip()
    text = f"[{HOST}] {title}"
    if body:
        text = f"{text}\n{body}"
    text = text[:MAX_LEN]
    key = f"{title}\n{body}"[:240]
    STATE_DIR.mkdir(mode=0o750, exist_ok=True)
    if not allow(key):
        return 0
    payload = json.dumps(
        {"username": "ovh-vps", "content": text},
        ensure_ascii=False,
    ).encode("utf-8")
    req = urllib.request.Request(
        load_webhook(),
        data=payload,
        method="POST",
        headers={"Content-Type": "application/json", "User-Agent": "vps-alert"},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            if resp.status not in (200, 204):
                print(f"vps-alert: unexpected status {resp.status}", file=sys.stderr)
                return 1
    except urllib.error.HTTPError as exc:
        print(f"vps-alert: http {exc.code}", file=sys.stderr)
        return 1
    except urllib.error.URLError:
        print("vps-alert: request failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
