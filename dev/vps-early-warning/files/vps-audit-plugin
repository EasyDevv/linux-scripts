#!/usr/bin/python3
"""auditd dispatcher plugin. Reads events on stdin and alerts on vps_ew."""

from __future__ import annotations

import os
import re
import subprocess
import sys

KEY_RE = re.compile(r'key="?vps_ew"?')
ALERT = "/usr/local/sbin/vps-alert"


def summarize(line: str) -> str:
    parts = []
    for field in ("exe", "name", "nametype", "syscall", "auid", "uid"):
        match = re.search(rf'\b{field}=([^\s]+)', line)
        if match:
            parts.append(f"{field}={match.group(1)}")
    if not parts:
        return line[:400]
    return " ".join(parts)[:400]


def main() -> int:
    sys.stdin.reconfigure(errors="replace")
    for line in sys.stdin:
        line = line.strip()
        if not line or not KEY_RE.search(line):
            continue
        summary = summarize(line)
        try:
            subprocess.Popen(
                [ALERT, "auditd", summary],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
