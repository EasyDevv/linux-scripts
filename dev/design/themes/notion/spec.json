{
	"slug": "notion",
	"liveUrl": "https://www.notion.com/ko",
	"imports": [
		"@import \"tailwindcss\";",
		"@import \"tw-animate-css\";",
		"@import \"shadcn-svelte/tailwind.css\";",
		"@import \"@fontsource-variable/inter\";"
	],
	"root": {
		"--background": "rgb(241, 241, 239)",
		"--foreground": "rgba(0, 0, 0, 0.95)",
		"--card": "rgb(255, 255, 255)",
		"--card-foreground": "rgba(0, 0, 0, 0.95)",
		"--popover": "rgb(255, 255, 255)",
		"--popover-foreground": "rgba(0, 0, 0, 0.95)",
		"--primary": "rgb(0, 117, 222)",
		"--primary-foreground": "rgb(255, 255, 255)",
		"--secondary": "rgb(241, 241, 239)",
		"--secondary-foreground": "rgba(0, 0, 0, 0.95)",
		"--muted": "rgb(241, 241, 239)",
		"--muted-foreground": "rgba(0, 0, 0, 0.54)",
		"--accent": "rgb(0, 117, 222)",
		"--accent-foreground": "rgb(255, 255, 255)",
		"--border": "rgb(233, 233, 231)",
		"--input": "rgb(233, 233, 231)",
		"--ring": "rgb(0, 117, 222)",
		"--sidebar": "rgb(255, 255, 255)",
		"--sidebar-foreground": "rgba(0, 0, 0, 0.95)",
		"--sidebar-primary": "rgb(0, 117, 222)",
		"--sidebar-primary-foreground": "rgb(255, 255, 255)",
		"--sidebar-accent": "rgb(241, 241, 239)",
		"--sidebar-accent-foreground": "rgba(0, 0, 0, 0.95)",
		"--sidebar-border": "rgb(233, 233, 231)",
		"--radius": "0.5rem",
		"--font-sans": "Inter, \"Noto Sans KR\", -apple-system, BlinkMacSystemFont, sans-serif"
	},
	"projectPrimitives": {
		"--card-spacing": "1rem",
		"--card-spacing-sm": "0.75rem",
		"--elevated-ring": "oklch(0.145 0 0 / 10%)",
		"--card-footer": "color-mix(in oklch, var(--muted) 50%, transparent)",
		"--font-heading": "var(--font-sans)",
		"--color-surface-100": "var(--card)",
		"--chart-axis-nudge": "0.5rem",
		"--radius-pill": "9999px",
		"--control-height-nav": "52px",
		"--control-height-md": "36px",
		"--ink-soft": "rgba(0, 0, 0, 0.898)"
	},
	"projectUtilities": {
		"--font-heading": "var(--font-heading)",
		"--color-elevated-ring": "var(--elevated-ring)",
		"--color-card-footer": "var(--card-footer)",
		"--color-surface-100": "var(--color-surface-100)",
		"--spacing-card": "var(--card-spacing)",
		"--spacing-card-sm": "var(--card-spacing-sm)",
		"--radius-pill": "var(--radius-pill)",
		"--font-display": "Inter, \"Noto Sans KR\", sans-serif",
		"--text-title": "22px",
		"--text-title--line-height": "26px",
		"--text-title--font-weight": "700",
		"--text-heading-sm": "15px",
		"--text-heading-sm--line-height": "20px",
		"--text-heading-sm--font-weight": "600",
		"--text-body-base": "16px",
		"--text-body-base--line-height": "24px",
		"--text-body-lg": "20px",
		"--text-body-lg--line-height": "26px",
		"--text-body-sm": "14px",
		"--text-body-sm--line-height": "20px",
		"--radius-sm": "4px"
	}
}
