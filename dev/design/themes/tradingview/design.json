		"action": {"fill": "--inspector", "border": "--inspector-border", "radius": "--radius-card", "pad": "41px 16px", "align": "center", "title": "sectionHeading", "body": "--text-body-base muted", "where": "CSV 파일 업로드, 수동으로 생성"},
		"tile": {"fill": "--card", "radius": "--radius", "pad": "12px", "selected": "--secondary", "where": "calendar day cards, perf tiles in widget"},
		"outlined": {"transparent": true, "border": "--input", "hairline": "--hairline-width", "radius": "--radius-card", "title": "--text-body-lg 500", "subtitle": "--text-body-base muted", "value": "--text-body-lg 500 + --text-micro uppercase unit", "where": "비교 카드 QQQM / TQQQ"},
		"notice": {"fill": "--notice", "color": "--notice-foreground", "radius": "8px", "pad": "8px 12px", "font": "--text-label-sm", "where": "widget news card; use for one highlighted sentence per panel"},
		"counters": {"fill": "--secondary", "radius": "--radius-tile", "pad": "4px 0", "label": "--text-body-lg 400", "value": "--text-stat", "where": "셀 2 · 뉴트럴 9 · 바이 15 under the rating gauge"},
		"gridGap": "32px"
	},
	"charts": {
		"canvas": "--background",
		"series": ["--chart-1", "--chart-2", "--chart-3", "--chart-4", "--chart-5"],
		"up": "--positive",
		"down": "--negative",
		"grid": "--border",
		"axis": "caption",
		"watermark": false,
		"rating": {"buy": "--rating-buy", "neutral": "--rating-neutral", "sell": "--rating-sell", "note": "technical ratings use blue for buy, not --positive; keep --positive/--negative for returns"},
		"areaLast": {"line": "--positive | --negative by session change", "gradient": "same hue to transparent", "lastTag": "series color plate, --primary-foreground text, on the price axis", "baseline": "dotted --muted-foreground line with a --secondary tag (이전 종가)"},
		"heat": {"from": "--negative-strong", "mid": "--secondary", "to": "--positive-strong"}
	},
	"header": {"shared": true, "height": "--header-height", "title": {"font": "--text-title", "from": "nav item", "row": "below the header, not in it"}, "stickySummary": {"height": "--header-height", "hairline": "--input", "pad": "0 40px", "price": "--text-heading 600", "delta": "--text-heading-sm 500", "where": "symbol bar that pins under the header on scroll"}, "pageTools": {"row": "sibling row under the title", "height": "--control-height-nav", "commit": "ml-auto"}},
	"notLinear": ["no floating inset panel: main is flush on the canvas", "no left rail: navigation is the top header; the rail is the right widget bar", "idle chip tabs are filled --tab-idle, selected is inverted --tab-selected", "page titles are 24px/600, not 13px panel labels"],
	"checklist": ["numbers right aligned", "every delta colored by sign with a leading sign glyph (+, −)", "units in --text-micro uppercase after the value", "tables flush to --page-gutter", "one --primary commit per page"]
