{
	"slug": "tradingview",
	"measuredAt": "2026-09-29",
	"supplementedAt": {"date": "2026-10-07", "pages": ["/symbols/NASDAQ-QQQ/", "/symbols/NASDAQ-QQQ/technicals/"], "why": "quant research screens use tooltips, KPI heroes, period presets, stat grids, notice cards and verdict tones the product pages did not cover"},
	"viewport": {"width": 1440, "height": 900, "scheme": "dark"},
	"thesis": "Black canvas, top header, flush content, and a right widget bar (panel + icon toolbar). Density comes from 41px table rows and hairline dividers, not from cards. Numbers carry the color: up and down are the only saturated inks besides the brand blue.",
	"applyOnto": "existing draft skeleton",
	"doNotCopy": ["TV wordmark and logo", "gradient 업그레이드 CTA", "broker/partner promos (TradeStation)", "Copilot and onboarding popovers", "chart canvas internals (candles, drawing tools)", "live ticker data", "ads"],
	"families": ["product-table", "overview-cards", "chart-tool", "symbol-page"],
	"shell": {
		"model": "top-header-plus-right-widgetbar",
		"canvas": "--background",
		"header": {"height": "--header-height", "fill": "--background", "hairline": false, "left": ["logo 34px", "search pill", "nav links"], "right": ["avatar", "primary CTA"], "navLink": {"height": "--header-control-height", "radius": "--radius-pill", "font": "--text-heading-sm", "color": "--foreground", "active": "--brand-link", "pad": "8px 12px"}},
		"main": {"fill": "--background", "flush": true, "gutter": "--page-gutter", "noFloatingPanel": true, "inset": "--panel-inset", "shadow": "--panel-shadow"},
		"sidebar": {"side": "right", "primitive": "Sidebar", "fill": "--sidebar", "width": "--sidebar-width", "collapsible": "offcanvas", "hideBelow": "--sidebar-hide-below", "collapse": {"mode": "slide-end", "duration": "--sidebar-collapse-duration", "ease": "--sidebar-collapse-ease"}, "borderAgainstCanvas": false, "seamToToolbar": "1px canvas gap", "widgetHeader": {"height": "--widget-header-height", "pad": "0 16px", "title": "--text-body-base", "weight": 600}, "rows": {"height": "--row-height-compact", "divider": "--border"}},
		"toolbar": {"side": "right", "width": "--toolbar-width", "fill": "--sidebar", "button": "--toolbar-button", "active": "--accent", "foldRule": "the active widget icon toggles the widget panel; clicking it again closes the panel"},
		"footer": "none"
	},
	"type": {
		"font": "--font-sans",
		"notDocumentBody": true,
		"roles": [
			{"id": "pageTitle", "font": "--text-title", "weight": 600, "color": "--foreground", "where": "포트폴리오, 모든 주식, 달력 h1; optional chevron when it opens a switcher"},
			{"id": "pageKicker", "font": "--text-body-base", "weight": 400, "color": "--foreground", "where": "스탁 스크리너 above the h1"},
			{"id": "kpiValue", "font": "--text-display", "weight": 700, "color": "--foreground", "where": "portfolio value −28,062.41"},
			{"id": "kpiUnit", "font": "--text-micro", "weight": 400, "color": "--foreground", "transform": "uppercase", "where": "USD, KRW beside a value"},
			{"id": "kpiDelta", "font": "--text-heading-sm", "weight": 500, "color": "--positive | --negative", "where": "−23.33% beside the value"},
			{"id": "cardTitle", "font": "--text-card-title", "weight": 400, "color": "--foreground", "where": "1_주식 포트폴리오"},
			{"id": "sectionHeading", "font": "--text-heading", "weight": 600, "color": "--foreground", "where": "CSV 파일 업로드, 수익률 비교"},
			{"id": "statLabel", "font": "--text-body-sm", "weight": 400, "color": "--muted-foreground", "where": "수익, 홀딩스, 업데이트됨"},
			{"id": "statValue", "font": "--text-heading-sm", "weight": 500, "color": "--foreground", "where": "−23.28%, 20"},
			{"id": "columnHeader", "font": "--text-body-base", "weight": 400, "color": "--muted-foreground", "where": "심볼, 가격, 발표, 예측, 이전"},
			{"id": "cell", "font": "--text-body-base", "weight": 400, "color": "--foreground", "align": "numbers right", "where": "table cells"},
			{"id": "cellDelta", "font": "--text-body-base", "weight": 400, "color": "--positive | --negative", "where": "+0.93%, −3.16%"},
			{"id": "cellUnit", "font": "--text-micro", "weight": 500, "color": "--foreground", "transform": "uppercase", "where": "KRW after a price"},
			{"id": "symbolBadge", "font": "--text-label-sm", "weight": 600, "color": "--foreground", "fill": "--badge", "radius": "--radius-badge", "height": "24px", "pad": "0 8px", "where": "005930"},
			{"id": "groupBarLabel", "font": "--text-body-base", "weight": 600, "color": "--foreground", "where": "9월 29일 화요일"},
			{"id": "tab", "font": "--text-body-lg", "weight": 400, "where": "chip tabs, square tabs, filter pills"},
			{"id": "caption", "font": "--text-label-sm", "weight": 400, "color": "--muted-foreground", "where": "day-card labels, axis ticks"},
			{"id": "heroValue", "font": "--text-hero", "weight": 700, "color": "--foreground", "where": "symbol page price 762.12"},
			{"id": "heroUnit", "font": "--text-heading-sm", "weight": 400, "color": "--foreground", "where": "USD after the hero value (not uppercase micro here)"},
			{"id": "heroDelta", "font": "--text-section-sm", "weight": 600, "color": "--positive | --negative", "where": "+5.92 +0.78% beside the hero value"},
			{"id": "heroAsOf", "font": "--text-body-lg", "weight": 400, "color": "--rating-neutral", "where": "오늘 00:51 GMT+9 기준 under the hero"},
			{"id": "pageHeadline", "font": "36px/44px", "weight": 600, "color": "--foreground", "where": "symbol name h1; product pages keep --text-title"},
			{"id": "sectionTitle", "font": "--text-section", "weight": 600, "color": "--foreground", "where": "주요 통계, 펀드 정보, 지표 요약"},
			{"id": "sectionTitleSm", "font": "--text-section-sm", "weight": 600, "color": "--foreground", "where": "인베스코 QQQ 와 비교하세요"},
			{"id": "statGridLabel", "font": "--text-body-lg", "weight": 400, "color": "--foreground", "where": "관리 자산 (AUM), 복제 방식 (3-column stat grid)"},
			{"id": "statGridValue", "font": "--text-stat", "weight": 600, "color": "--foreground", "where": "504.03 B, 피지컬"},
			{"id": "lead", "font": "--text-lead", "weight": 400, "color": "--foreground", "where": "section intro paragraph on /technicals"},
			{"id": "widgetKpi", "font": "--text-display", "weight": 600, "color": "--foreground", "where": "widget bar details price 762.19 (28/36 600, not 700)"},
			{"id": "widgetGroupLabel", "font": "--text-micro", "weight": 400, "color": "--muted-foreground", "where": "지수, 선물 group headers in the watchlist"},
			{"id": "readingNote", "font": "--text-body-sm", "weight": 400, "color": "--muted-foreground", "where": "one-line 읽는 법 under a chart (project addition, same role as statLabel)"}
		]
	},
	"controls": {
		"chipTabs": {"height": "--control-height-nav", "radius": "--radius-pill", "pad": "0 15px", "font": "--text-body-lg", "selected": {"fill": "--tab-selected", "color": "--tab-selected-foreground"}, "idle": {"fill": "--tab-idle", "color": "--foreground"}, "gap": "8px", "where": "이코노믹/어닝/배당/IPO, 차트/맵, 체인/전략 빌더"},
		"squareTabs": {"height": "--control-height-nav", "radius": "--radius-md", "pad": "0 12px", "font": "--text-body-lg", "selected": {"fill": "--secondary", "color": "--foreground", "weight": 600}, "idle": {"transparent": true, "color": "--foreground"}, "where": "screener column sets 오버뷰/성과/테크니컬즈"},
		"filterPill": {"height": "--control-height", "radius": "--radius", "border": "--input", "hairline": "--hairline-width", "transparent": true, "font": "--text-body-lg", "color": "--foreground", "trailing": "chevron-down", "where": "screener filters 지수, 가격, P/E"},
		"outlineButton": {"height": "--control-height", "radius": "--radius", "border": "--input", "transparent": true, "pad": "0 11px", "font": "--text-body-lg", "where": "오늘, + 넣기"},
		"ghostButton": {"height": "--control-height", "radius": "--radius", "transparent": true, "pad": "0 7px", "font": "--text-body-lg", "where": "모든 카테고리, time zone"},
		"iconButton": {"size": "--icon-button", "radius": "--radius", "border": "--input", "transparent": true, "where": "settings, share, fullscreen, collapse"},
		"commit": {"kind": "filled", "fill": "--primary", "color": "--primary-foreground", "radius": "--radius", "height": "--control-height", "font": "--text-body-lg", "note": "the live 업그레이드 gradient is brand marketing; product commits use --primary"},
		"search": {"height": "--header-control-height", "radius": "--radius-pill", "fill": "--search-fill", "color": "--search-foreground", "pad": "6px", "where": "header 찾기 (Ctrl+K)"},
		"tooltip": {"fill": "--tooltip", "color": "--tooltip-foreground", "font": "--text-body-sm", "radius": "--radius-tag", "pad": "6px 8px", "maxWidth": "400px", "arrow": false, "side": "top", "offset": "6px", "align": "start", "where": "dotted-underline terms, toolbar icons (apply-common-tooltip)"},
		"term": {"decoration": "underline dotted", "decorationColor": "--muted-foreground", "where": "CEOJLU code; any label whose meaning sits in a tooltip"},
		"rangeButtons": {"height": "74px", "radius": "--radius-tile", "pad": "8px 18px", "lines": ["period --text-body-lg 500 --foreground", "change --text-body-lg 500 --positive | --negative"], "selected": {"fill": "--secondary"}, "idle": {"transparent": true}, "where": "1 날 / 5 날 / 1달 / … / 전체기간 under the symbol chart; one preset per window with its return"},
		"intervalTabs": {"height": "--control-height-nav", "radius": "6px", "pad": "0 12px", "font": "--text-body-lg", "selected": {"fill": "--secondary", "color": "--tooltip-foreground", "weight": 600}, "idle": {"transparent": true, "color": "--foreground", "weight": 400}, "where": "1 분 … 1달 on /technicals"},
		"underlineTabs": {"font": "--text-body-lg", "weight": 600, "pad": "0 0 8px", "indicator": {"height": "4px", "fill": "--tab-selected", "width": "content-centered"}, "track": "--secondary", "where": "오버뷰 / 프로화일 / 홀딩스 page sections"},
		"tag": {"fill": "--secondary", "radius": "--radius-tag", "height": "16px", "font": "--text-label-sm", "color": "--foreground", "where": "추가 +2"},
		"symbolChip": {"height": "--control-height-nav", "radius": "--radius", "border": "--input", "hairline": "--hairline-width", "pad": "0 11px", "font": "--text-body-lg", "where": "QQQ · Nasdaq Stock Market identity chip"},
		"dateNav": {"kind": "outline today + calendar icon + prev/next chevrons + range title", "title": "--text-card-title", "weight": 600}
	},
	"lists": {
		"kind": "full-width table with hairline row dividers, no zebra, no cards",
		"row": {"height": "--row-height", "divider": "--border", "hairline": "--hairline-width", "cellPad": "0 12px", "hover": "--accent"},
		"header": {"height": "50px", "divider": "--input", "font": "--text-body-base", "color": "--muted-foreground", "sortIndicator": "arrow before the active column label"},
		"groupBar": {"height": "--group-bar-height", "fill": "--group-bar", "pad": "0 20px", "accent": "4px start bar --foreground on the current group", "label": "groupBarLabel"},
		"compactRow": {"height": "--row-height-compact", "where": "widget bar watchlist"},
		"numbers": "right aligned; delta ink --positive/--negative; no +/- color on neutral values"
	},
