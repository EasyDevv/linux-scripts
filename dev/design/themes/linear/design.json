{
	"slug": "linear",
	"measuredAt": "2026-09-06",
	"viewport": { "width": 1440, "height": 900, "scheme": "dark" },
	"thesis": "Canvas plus a floating main panel. layout.css owns values; this file says which token applies and what not to copy.",
	"applyOnto": "existing draft skeleton",
	"doNotCopy": ["wordmark", "illustrations", "page IA"],
	"families": ["product", "settings-list", "settings-form"],
	"shell": {
		"model": "canvas-plus-floating-main",
		"canvas": "--background",
		"sidebar": {
			"fill": "--sidebar",
			"width": "--sidebar-width",
			"onCanvas": true,
			"borderAgainstCanvas": false,
			"radius": false,
			"collapsible": "offcanvas",
			"hideBelow": "--sidebar-hide-below",
			"collapse": {
				"mode": "slide-start",
				"duration": "--sidebar-collapse-duration",
				"ease": "--sidebar-collapse-ease"
			},
			"gutterToMain": "--panel-inset",
			"variant": "sidebar",
			"primitive": "Sidebar",
			"nav": {
				"item": "Sidebar.MenuButton",
				"size": "sm",
				"height": "--control-height-nav",
				"radius": "--radius-sm",
				"font": "--text-heading-sm",
				"idle": "--muted-foreground",
				"active": "--foreground",
				"activeBg": "--sidebar-accent",
				"icon": "size-3.5",
				"not": "default Button"
			}
		},
		"main": {
			"fill": "--card",
			"origin": ["--sidebar-width", "--panel-inset"],
			"inset": "--panel-inset",
			"radius": "--radius",
			"border": "--border",
			"hairline": "--hairline-width",
			"shadow": "--panel-shadow",
			"clipToRadius": true,
			"primitive": "Sidebar.Inset"
		},
		"inspectors": "quiet rectangles inside main, not a second floating app",
		"notLinear": ["sidebar border-r", "flush rectangular content pane", "sidebar-07 inset header", "collapsible=icon"]
	},
	"type": {
		"font": "--font-sans",
		"notDocumentBody": true,
		"notMarketingScale": true,
		"notTitleOnTopBar": true,
		"roles": [
			{ "id": "sidebarLabelIdle", "font": "--text-heading-sm", "weight": 500, "color": "--muted-foreground", "where": "Inbox, My issues, nested team links" },
			{ "id": "sidebarLabelActive", "font": "--text-heading-sm", "weight": 500, "color": "--foreground", "fill": "--sidebar-accent", "where": "same size as idle" },
			{ "id": "panelHeaderTitle", "font": "--text-heading-sm", "weight": 500, "color": "--ink-soft", "where": "h2 next to favorite star, not a page title" },
			{ "id": "pillTab", "font": "--text-label-sm", "weight": 500, "selected": "--foreground", "idle": "--muted-foreground", "where": "Overview / All projects / All issues" },
			{ "id": "ghostAction", "font": "--text-label-sm", "weight": 500, "color": "--ink-subtle", "where": "product + New project, Invite members" },
			{ "id": "columnHeader", "font": "--text-body-sm", "weight": 450, "color": "--muted-foreground", "transform": "none", "where": "Name, Health, Status" },
			{ "id": "issueIdentifier", "font": "--text-body-base", "weight": 450, "color": "--muted-foreground", "where": "EAS-1" },
			{ "id": "issueTitle", "font": "--text-heading-sm", "weight": 500, "color": "--foreground", "where": "list primary identity" },
			{ "id": "groupHeader", "font": "--text-heading-sm", "weight": 500, "color": "--ink-soft", "where": "Todo" },
			{ "id": "propertyChip", "font": "--text-heading-sm", "weight": 500, "color": "--ink-soft", "where": "Backlog, No priority" },
			{ "id": "memberName", "font": "--text-heading-sm", "weight": 500, "color": "--ink-soft" },
			{ "id": "sectionHeading", "font": "--text-heading", "color": "--foreground", "where": "settings groups" },
			{ "id": "heroIdentity", "font": "--text-title", "weight": 600, "color": "--foreground", "where": "project/team name under panel header" },
			{ "id": "settingsPageTitle", "font": "--text-title", "weight": 500, "color": "--foreground", "where": "settings h1 in the content column" },
			{ "id": "productLede", "font": "--text-heading", "weight": 450, "color": "--ink-soft", "where": "project tagline under heroIdentity" },
			{ "id": "settingsLede", "font": "--text-body-base", "weight": 450, "color": "--muted-foreground", "where": "one line under settings page title" }
		]
	},
	"controls": {
		"navRow": {
			"height": "--control-height-nav",
			"radius": "--radius-sm",
			"activeBg": "--sidebar-accent",
			"noAccentBar": true
		},
		"tabs": {
			"selected": "filled capsule",
			"radius": "--radius-pill",
			"height": "--control-height-nav",
			"unselected": "ghost"
		},
		"productCta": { "kind": "ghost", "font": "--text-label-sm" },
		"emphasis": { "fill": "--primary", "where": "settings Invite, Create team, Upgrade now" },
		"emptyAction": {
			"height": "--control-height",
			"font": "--text-heading-sm",
			"color": "--muted-foreground",
			"radius": "--radius-sm",
			"notIllustrated": true
		},
		"search": "icon or quiet inline field, never a hero search"
	},
	"lists": {
		"kind": "quiet grid, not card stack",
		"issuePitch": 36,
		"projectPitch": 56,
		"left": ["handle?", "identifier muted", "status dot", "title"],
		"right": ["assignee avatar", "short date"],
		"groupBar": {
			"height": "--control-height-nav",
			"radius": "--radius-sm",
			"fill": "--sidebar-accent"
		},
		"columnHeader": { "font": "--text-body-sm", "color": "--muted-foreground" },
		"noZebra": true,
		"noRowCards": true,
		"status": "dot or one-word chip",
		"inspector": "right column inside main, same surface, not a modal"
	},
	"header": {
		"shared": true,
		"height": "--control-height-nav",
		"row": "flex h-11 shrink-0",
		"fold": { "primitive": "Sidebar.Trigger", "size": "icon-sm", "color": "--muted-foreground" },
		"title": { "font": "--text-heading-sm", "color": "--ink-soft", "from": "nav item" },
		"extras": "{#snippet header()} only"
	},
	"settings": {
		"keepsShell": true,
		"replacesProductNav": true,
		"measure": "content column past --sidebar-width, not the first h1",
		"rail": {
			"backToApp": {
				"kind": "ghost pill",
				"height": "--control-height-nav",
				"font": "--text-heading-sm",
				"color": "--muted-foreground",
				"radius": "--radius-pill"
			},
			"search": {
				"height": "--control-height-nav",
				"radius": "--radius-sm",
				"fill": "--secondary",
				"border": "--border"
			},
			"sectionLabel": {
				"font": "--text-heading-sm",
				"weight": 500,
				"color": "--muted-foreground",
				"notPageTitle": true
			},
			"row": {
				"height": "--control-height-nav",
				"radius": "--radius-sm",
				"activeBg": "--sidebar-accent",
				"active": "--foreground"
			}
		},
		"listFamily": {
			"pages": ["settings/teams", "settings/members"],
			"title": { "font": "--text-title", "weight": 500, "align": "start of main" },
			"toolbarHeight": "--control-height",
			"mutedFill": "--accent",
			"primary": { "fill": "--primary", "radius": "--radius-pill" },
			"tables": "same as product lists"
		},
		"formFamily": {
			"pages": ["settings/workspace", "settings/security", "settings/api", "settings/applications", "settings/billing", "settings/usage", "settings/import-export", "settings/integrations", "settings/teams/EAS/general", "settings/teams/EAS/workflow", "settings/new-team"],
			"column": "--content-narrow",
			"title": { "font": "--text-title", "weight": 500 },
			"lede": { "font": "--text-body-base", "weight": 450, "color": "--muted-foreground", "where": "one line under a section heading, never per field" },
			"section": { "font": "--text-heading", "color": "--foreground" },
			"well": { "fill": "--secondary", "radius": "--radius-md" },
			"titleToFirstWell": "gap-8",
			"betweenGroups": "gap-12",
			"formRow": {
				"label": { "font": "--text-heading-sm", "color": "--foreground" },
				"orientation": "horizontal until well @container 28rem, then stack",
				"input": { "height": "--control-height", "radius": "--radius-sm", "border": "--input", "onWell": true },
				"select": { "height": "--control-height", "radius": "--radius-sm", "fill": "--accent", "color": "--accent-foreground", "weight": 500 }
			},
			"denseOptions": "chips in one row, not a switch per item",
			"groupLabel": { "font": "--text-heading-sm", "color": "--ink-soft" }
		},
		"nestedTeam": {
			"panelHeader": { "font": "--text-heading-sm" },
			"pageTitle": { "font": "--text-title", "weight": 500 }
		},
		"ghost": { "height": "--control-height", "radius": "--radius-pill" },
		"mutedFill": { "height": "--control-height", "radius": "--radius-pill", "fill": "--accent" },
		"destructive": { "kind": "ghost/text", "color": "--destructive", "notFilled": true },
		"switchOn": { "fill": "--primary" }
	},
	"color": {
		"model": "grayscale plus one local accent",
		"canvas": "--background",
		"sidebar": "--sidebar",
		"panel": "--card",
		"well": "--secondary",
		"popover": "--popover",
		"navActive": "--sidebar-accent",
		"hover": "--accent",
		"ink": ["--foreground", "--ink-soft", "--muted-foreground", "--ink-subtle"],
		"emphasis": "--primary",
		"emphasisNotNavFill": true,
		"colorMeans": ["state", "identity"],
		"sameTokensInLight": true
	},
	"skipUnlessDraftHas": [
		"command menu",
		"agent dock outside main",
		"favorite star beside panel header",
		"sidebar onboarding block",
		"marketing heroes"
	],
	"checklist": [
		"canvas sidebar; main uses --radius and --panel-inset on every side (never flush to the rail)",
		"sidebar offcanvas slides with --sidebar-collapse-duration / --sidebar-collapse-ease; hide the rail below --sidebar-hide-below",
		"product header is --text-heading-sm; --text-title is content identity",
		"settings page title is --text-title weight 500 in the content column",
		"nav rows use --control-height-nav, --radius-sm, --sidebar-accent when active",
		"product header actions are ghost --text-label-sm; settings may use one --primary pill at --control-height",
		"lists: muted identifier, primary title, status dot, no card-per-row",
		"settings forms: --content-narrow, --secondary wells, gap-12 between groups",
		"section lede only; input sits on the well with --input hairline; select fill --accent",
		"dense options are chips in one row, not a switch list",
		"one accent as state; hairline --hairline-width plus --panel-shadow"
	]
}
