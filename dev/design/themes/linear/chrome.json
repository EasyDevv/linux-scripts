			"fill": "--foreground"
		},
		"skeleton": {
			"fill": "--muted",
			"radius": "--radius-md",
			"keepChrome": true,
			"slotsOnly": true,
			"keepLastNumbers": true
		},
		"selectMenu": {
			"fill": "--select-menu",
			"border": "--select-menu-border",
			"itemHighlight": "--select-item-highlight",
			"highlightInsetInline": 4,
			"highlightRadius": "--radius-sm",
			"itemHeight": "--control-height",
			"checkAfterLabel": true,
			"alignSelectedToTrigger": true
