{
	"slug": "toss",
	"measuredAt": "2026-09-29",
	"source": "https://tossmini-docs.toss.im/tds-mobile/",
	"designSystem": "TDS Mobile (토스 디자인 시스템 모바일)",
	"viewport": {
		"width": 1440,
		"height": 900,
		"mobile": 390,
		"scheme": "light"
	},
	"thesis": "White mobile screens made of full-width rows inset 24px, big type, and one blue primary action. layout.css owns values in three layers — adaptive palette (grey/blue/red/orange/yellow/green/teal/purple 50-900 + grey-opacity) → roles (surface / ink / status) → per-component geometry. Snippets in components/ read roles, never the palette directly unless the TDS default names a step.",
	"applyOnto": "mobile-first product screens (390 wide); desktop only as a centred column",
	"doNotCopy": [
		"Nextra docs ink, code-block palette and nav blur (ref/chrome.ts docsMark) — docs chrome, not TDS",
		"the 256px docs sidebar and 1440 docs shell (theme-ref reconstruction only)",
		"Toss Product Sans / Tossface (commercial): the stack falls back to Pretendard / system",
		"TDS icon and lottie URLs (static.toss.im) — use the product's own icon set"
	],
	"families": [
		"mobile-screen",
		"settings-list",
		"form",
		"sheet-flow"
	],
	"color": {
		"model": "adaptive",
		"palette": "--grey-50 … --purple-900, --grey-opacity-50 … 900 (both redefined under .dark)",
		"note": "Every TDS colour is an adaptive pair. Components never branch on scheme; .dark swaps the ramp. Hue steps flip in dark (50 is darkest), so a weak fill that reads 400 in light reads the dark 400 in dark.",
		"surfaces": {
			"screen": "--surface-base",
			"canvas": "--surface-grey",
			"layered": "--surface-layered",
			"float": "--surface-float",
			"well": "--surface-well",
			"pressed": "--surface-hover",
			"selected": "--surface-selected",
			"hairline": "--hairline",
			"dim": "--overlay-dimmed"
		},
		"ink": {
			"strong": "--ink-strong",
			"default": "--ink",
			"soft": "--ink-soft",
			"subtle": "--ink-subtle",
			"faint": "--ink-faint",
			"disabled": "--ink-disabled",
			"onFill": "--ink-on-fill",
			"link": "--ink-link"
		},
		"status": {
			"info": "--status-info",
			"success": "--status-success",
			"warning": "--status-warning",
			"danger": "--status-danger",
			"neutral": "--status-neutral",
			"rating": "--status-rating",
			"weakInfo": "--weak-info",
			"weakDanger": "--weak-danger"
		},
		"shadcn": {
			"canvas": "--background",
			"paper": "--card",
			"note": "shadcn --background is the canvas, so it maps to greyBackground; the white screen surface stays on --card. Equal values fail validate-layout-scheme."
		},
		"darkMode": {
			"status": "unofficial",
			"policy": "Apps in Toss does not support dark mode: mini-apps must be designed, built and released in light mode (guide/faq.md, design/prepare/design.md \"추후 지원 예정\", checklist/app-nongame.md \"미니앱 테마는 라이트 모드로 구현\"). Light is the only authoritative scheme.",
			"source": "The .dark palette is the adaptive pairs left on the docs site (:root resolves them to dark under html.light), plus three derived tweaks (black floating shadows, dark Button label = --surface-base, static --highlight-dim). Reference only — do not ship a mini-app on it.",
			"shadowNote": "TDS React Native ShadowBackground example uses a black lightColor and a white darkColor; this theme keeps black shadows in dark on purpose (--shadow-float* under .dark)."
		}
	},
	"type": {
		"family": "--font-sans",
		"scale": "--text-t1 … --text-t7, --text-st1 … --text-st13 (TDS foundation/typography; leading x1.5, x4/3 from 30px)",
		"roles": {
			"display": "--text-display",
			"title": "--text-title",
			"heading": "--text-heading",
			"headingSm": "--text-heading-sm",
			"subheading": "--text-subheading",
			"body": "--text-body",
			"bodySm": "--text-body-sm",
			"label": "--text-label",
			"labelSm": "--text-label-sm",
			"caption": "--text-caption"
		},
		"controlLabels": {
			"small": "--text-control-sm",
			"medium": "--text-control-md",
			"large": "--text-control",
			"textButtonLarge": "--text-control-lg",
			"textButtonXl": "--text-control-xl",
			"textButton2xl": "--text-control-2xl",
			"leading": "--control-label-leading",
			"note": "Button / Tab / TextButton labels use fontSize x 1.252, never the scale line height."
		},
		"listTexts": {
			"title": "--text-row",
			"sub": "--text-row-sm",
			"caption": "--text-row-xs",
			"note": "ListRow, BoardRow, Post headings use leading x1.35."
		},
		"weights": "400 body · 500 list titles and menu items · 600 buttons, labels · 700 titles, selected tab"
	},
	"controls": {
		"button": {
			"sizes": {
				"small": [
					"--control-height-sm",
					"--control-radius-sm",
					"--control-padding-inline-sm",
					"--text-control-sm"
				],
				"medium": [
					"--control-height",
					"--control-radius",
					"--control-padding-inline",
					"--text-control-md"
				],
				"large": [
					"--control-height-lg",
					"--control-radius-lg",
					"--control-padding-inline",
					"--text-control"
				],
				"xlarge": [
					"--control-height-xl",
					"--control-radius-xl",
					"--control-padding-inline-xl",
					"--text-control"
				]
			},
			"fill": {
				"primary": "--blue-500",
				"dark": "--grey-700",
				"danger": "--red-500",
				"light": "--static-white",
				"ink": "--ink-on-fill"
			},
			"weak": {
				"primary": "--weak-info",
				"dark": "--grey-opacity-100",
				"danger": "--weak-danger",
				"light": "--on-fill-weak"
			},
			"disabled": "--control-disabled-opacity",
			"structure": "fill is a child layer under the label; radius on the button",
			"snippet": "components/button.svelte"
		},
		"textButton": {
			"ink": "--ink-subtle",
			"pressed": "--grey-opacity-100",
			"snippet": "components/text-button.svelte"
		},
		"iconButton": {
			"box": "--icon-button-size",
			"radius": "--icon-button-radius",
			"fill": "--grey-opacity-100",
			"border": "--hairline-width",
			"snippet": "components/icon-button.svelte"
		},
		"checkbox": {
			"size": "--checkbox-size",
			"gap": "--checkbox-label-gap",
			"idle": "--grey-300",
			"active": "--status-info",
			"snippet": "components/checkbox.svelte"
		},
		"switch": {
			"track": [
				"--switch-width",
				"--switch-height"
			],
			"thumb": [
				"--switch-thumb-off",
				"--switch-thumb-on",
				"--switch-thumb-inset"
			],
			"idle": "--grey-200",
			"active": "--status-info",
			"snippet": "components/switch.svelte"
		},
		"segmented": {
			"height": "--segment-height",
			"radius": "--segment-radius",
			"thumbRadius": "--segment-thumb-radius",
			"padding": "--segment-padding",
			"fill": "--grey-opacity-100",
			"thumb": "--surface-float",
			"shadow": "--shadow-thumb",
			"snippet": "components/segmented-control.svelte"
		},
		"tab": {
			"height": "--tab-height",
			"inset": "--tab-inset",
			"itemPadding": "--tab-item-padding",
			"indicator": [
				"--tab-indicator-height",
				"--tab-indicator-inset"
			],
			"selected": "--ink",
			"idle": "--ink-subtle",
			"snippet": "components/tab.svelte"
		},
		"badge": {
			"sizes": "21/24/26/29 high, radius 9/11/12/13 (per size, not one step)",
			"weak": "hue 400 at 16%",
			"snippet": "components/badge.svelte"
		},
		"textField": {
			"box": [
				"--field-box-height",
				"--field-box-padding",
				"--field-box-radius"
			],
			"rule": "--grey-opacity-100",
			"well": "--surface-well",
			"underline": "--field-underline-width",
			"insets": [
				"--field-inset",
				"--row-inset"
			],
			"focus": "--status-info",
			"error": "--status-danger",
			"snippet": "components/text-field.svelte"
		},
		"searchField": {
			"height": "--field-well-height",
			"radius": "--field-well-radius",
			"padding": "--field-well-padding",
			"fill": "--grey-opacity-100",
			"snippet": "components/search-field.svelte"
		}
	},
	"lists": {
		"row": {
			"inset": "--row-inset",
			"padding": [
				"--list-row-padding-sm",
				"--list-row-padding",
				"--list-row-padding-lg",
				"--list-row-padding-xl"
			],
			"gap": "--list-row-gap",
			"pressed": [
				"--grey-opacity-50",
				"--list-row-radius"
			],
			"divider": "--hairline",
			"title": "--ink-soft",
			"twoRowTitle": "--ink",
			"sub": "--ink-subtle",
			"snippet": "components/list-row.svelte"
		},
		"header": {
			"padding": "--list-header-padding",
			"title": "--ink",
			"description": "--ink-subtle",
			"snippet": "components/list-header.svelte"
		},
		"footer": {
			"height": "--list-footer-height",
			"ink": "--ink-link",
			"snippet": "components/list-footer.svelte"
		},
		"grid": {
			"gap": "--grid-gap",
			"cell": [
				"--grid-cell-radius",
				"--grid-cell-padding"
			],
			"fill": "--surface-well",
			"snippet": "components/grid-list.svelte"
		},
		"stepper": {
			"inset": "--stepper-inset",
			"icon": "--stepper-icon",
			"gap": "--stepper-icon-gap",
			"connector": "--stepper-connector-width",
			"snippet": "components/stepper.svelte"
		},
		"sectionBreak": "--section-divider-height"
	},
	"overlays": {
		"dim": "--overlay-dimmed",
		"dialog": {
			"width": "--dialog-width",
			"radius": "--dialog-radius",
			"fill": "--surface-float",
			"snippet": "components/dialog.svelte"
		},
		"sheet": {
			"inset": "--sheet-inset",
			"radius": "--sheet-radius",
			"handle": "--sheet-handle",
			"fill": "--surface-float",
			"snippet": "components/bottom-sheet.svelte"
		},
		"toast": {
			"height": "--toast-height",
			"shadow": "--shadow-toast",
			"fill": "--surface-float",
			"snippet": "components/toast.svelte"
		},
		"tooltip": {
			"radius": [
				"--tooltip-radius",
				"--tooltip-radius-sm"
			],
			"shadow": "--shadow-float-strong",
			"snippet": "components/tooltip.svelte"
		},
		"menu": {
			"width": "--menu-width",
			"radius": "--menu-radius",
			"glass": [
				"--surface-glass",
				"--glass-blur"
			],
			"shadow": "--shadow-float",
			"snippet": "components/menu.svelte"
		},
		"bottomCta": {
			"inset": "--cta-inset",
			"button": "--control-height-xl",
			"snippet": "components/bottom-cta.svelte"
		}
	},
	"feedback": {
		"track": [
			"--track-height",
			"--track-radius"
		],
		"trackFill": "--grey-200",
		"progress": "--blue-400",
		"slider": "--slider-hit",
		"loader": "--loader-stroke",
		"skeleton": "--skeleton-fill"
	},
	"notLinear": {
		"edges": "Boundaries are 1px hairlines between rows or a 0.8px greyOpacity100 rule on wells. Cards do not float on shadows.",
		"elevation": "Only floating layers (toast, tooltip, menu, segmented thumb) carry shadows; screens stack by surface-grey vs surface-base.",
		"primaryAction": "One blue500 solid button per screen, usually xlarge (56h) in a BottomCTA; secondary is weak dark.",
		"density": "Rows are 44-87px; text is 17px by default. No 28-32px desktop rows.",
		"radius": "Radius grows with control size (8/10/14/16) and is per-size for badges; there is no single 4-step scale.",
		"font": "Toss Product Sans (commercial) → Pretendard / system; weight 600 for actions, 700 for titles.",
		"copy": "Korean, polite 해요체 (…해요 / …했어요)."
	},
	"shell": {
		"model": "docs shell (ref only): 256 sidebar on the grey canvas + floating white panel",
		"canvas": "--background",
		"sidebar": {
			"width": "--sidebar-width",
			"fill": "--sidebar",
			"active": "--sidebar-accent",
			"activeInk": "--sidebar-accent-foreground",
			"borderAgainstCanvas": true,
			"hideBelow": null
		},
		"panel": {
			"fill": "--card",
			"inset": "--panel-inset",
			"radius": "--radius",
			"contentNarrow": "--content-narrow"
		},
		"footer": {
			"insideMain": false,
			"hairline": true,
			"height": "--shell-footer-height"
		}
	},
	"checklist": [
		"Ship light mode only (Apps in Toss has no dark mode); .dark is reference",
		"Screen background --surface-base (white), grouped screens on --surface-grey",
		"Rows inset --row-inset (24), fields inset --field-inset (20), CTA bar --cta-inset (20)",
		"Button labels leading --control-label-leading, list texts --text-row*",
		"Every colour through a role or ramp token — never a hex — so .dark works",
		"Dim overlays with --overlay-dimmed (20% light / 56% dark)"
	]
}