			"--ink-strong": "Ink roles: TDS component defaults, highest to lowest emphasis",
			"--status-info": "Status roles: badge / progress / toast tones",
			"--shadow-float": "Elevation: measured floating shadows (menu, tooltip, toast, segmented thumb)",
			"--hairline-width": "Rules",
			"--control-height-sm": "Controls: Button small / medium / large / xlarge. Label leading is fontSize x 1.252, not the text scale.",
