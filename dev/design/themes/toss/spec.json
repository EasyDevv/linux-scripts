			"--tab-height": "Navigation: Tab, SegmentedControl, Stepper",
			"--dialog-width": "Overlays: Dialog, BottomSheet, Toast, Tooltip, Menu",
			"--track-height": "Feedback: ProgressBar / Slider track, Loader, Skeleton",
			"--sidebar-width": "Shell: docs chrome measured at 1440x900",
			"--card-spacing": "_core primitives, TDS values",
			"--keypad-secure": "Secure keypad: always-dark input chrome (same in both schemes)",
			"--text-t1": "Type scale (runtime values; @theme inline only points at them so scoped component CSS can read var(--text-t5) too)",
			"--highlight-dim": "Highlight coach-mark mask: measured greyOpacity700 (light), kept static so dark does not turn it white"
