# .env.txt 작성 예시. 이 파일을 같은 폴더에 ".env.txt"로 복사해 값을 입력.
# 형식: KEY=value 한 줄에 하나. # 주석·빈 줄 무시. 값에 따옴표 불필요.
# 실제 키·링크가 든 .env.txt는 분실 주의 (CLEANUP이 자동 삭제하지 않음).

# Tailscale 자동접속 키.
# 발급: Tailscale 관리 콘솔 → Settings → Keys → Generate auth key.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 데스크탑 Orca 액세스 링크.
# 발급: 데스크탑 Orca → Settings → Remote Orca Servers → New Link →
#       Connection address에서 Tailscale 주소(100.x) 선택 → Generate Access Link.
ORCA_CLIENT_URL=orca://pair?code=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
